# All of these are validated at startup by src/config/env.validation.ts.
# The API refuses to boot if a required value is missing or malformed.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Required.
DATABASE_URL=

# Required. Use two different secrets so a leaked access token cannot be
# replayed as a refresh token.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Optional. Signed uploads for task attachments (images/files via Cloudinary).
# Until all three are set, file uploads are disabled and task links still work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Google OAuth (sign-in via Gmail). When any value is missing, the
# web client hides the "Continue with Google" button and /auth/google returns 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Optional. Resend outbound invite email. Without a key, invites are created and
# the invite link is returned to the inviter instead of emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL="LGA <onboarding@lga.dev>"

# Public origin of the web app, used to build invite links in emails.
WEB_APP_URL=http://localhost:3000

# Optional. Python AI / RAG service URL. Defaults to http://localhost:5000/api/ai
AI_SERVICE_URL=http://localhost:5000/api/ai


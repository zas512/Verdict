# Backend API URL (NestJS backend API)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public origin of the site. Used for canonical/OG URLs, sitemap, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth Client ID (Optional - leave blank if not configured)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Analytics 4 Measurement ID (Optional - GA loads only when set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token (Optional - meta tag only when set)
NEXT_PUBLIC_GSC_VERIFICATION=

# AI Feature Flag
NEXT_PUBLIC_AI_FLAG=true
AI_FLAG=true
DIALER_FLAG=true
